# =================================================================
# INVENTIA POS SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Copy this file to .env for local development or enter these in Vercel.

PORT=3000

# -----------------------------------------------------------------
# SUPABASE CLOUD DATABASE CONFIGURATION (Production Engine)
# -----------------------------------------------------------------
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings -> API to find your Project URL and Anon/Service Keys.
# 3. If these keys are NOT set, the app automatically runs using the local SQLite pos.db!

SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# -----------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -----------------------------------------------------------------
JWT_SECRET=super-secret-production-jwt-token-key-change-this
TENANT_MASTER_KEY=use-a-separate-32-byte-or-longer-encryption-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# -----------------------------------------------------------------
# PHASE 5 CONTROL PLANE, TENANT DATABASES, CACHE, JOBS, REALTIME
# -----------------------------------------------------------------
# Docker Compose values are shown. Omit these for SQLite compatibility mode.
CONTROL_DATABASE_URL=postgres://inventia:inventia-local-password@localhost:5432/inventia_control
TENANT_DATABASE_ADMIN_URL=postgres://inventia:inventia-local-password@localhost:5432/postgres
REDIS_URL=redis://localhost:6379
DB_POOL_SIZE=10
WORKER_CONCURRENCY=5
DEFAULT_ORGANIZATION_SLUG=northwind-interiors
DEFAULT_ORGANIZATION_NAME=Northwind Interiors
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------
# OPENAI BUSINESS COPILOT (server-side only)
# -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_CHAT_REASONING=low
OPENAI_TIMEOUT_MS=25000

# -----------------------------------------------------------------
# OFFICIAL RAZORPAY (server-side only; blank means unconfigured/503)
# -----------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------
# STORAGE ADAPTER
# -----------------------------------------------------------------
# Local storage is used when these are blank.
SUPABASE_STORAGE_BUCKET=
LOCAL_STORAGE_DIR=
INVOICE_STORAGE_DIR=
MAX_UPLOAD_BYTES=10485760
INVOICE_PDF_TIMEOUT_MS=30000
